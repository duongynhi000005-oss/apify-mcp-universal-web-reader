{
  "actorSpecification": 1,
  "name": "mcp-universal-web-reader-for-ai-agents",
  "title": "MCP Universal Web Reader for AI Agents (Pay-Per-Page)",
  "description": "Blazing-fast, LLM-optimized web content reader & converter for Claude, Cursor, ChatGPT, and MCP clients. Converts raw HTML into noise-free Markdown with tables and token estimates at $0.004/page.",
  "version": "1.0.0",
  "meta": {
    "templateId": "project_cheerio_crawler_js"
  },
  "pricing": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPlan": {
      "path": ".actor/pay_per_event.json"
    }
  },
  "categories": [
    "AI",
    "DEVELOPER_TOOLS",
    "INTEGRATIONS"
  ],
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 512,
    "timeoutSecs": 300
  },
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "Extracted Web Markdown Documents Output",
    "properties": {
      "dataset": {
        "type": "string",
        "title": "Extracted Web Markdown Documents",
        "template": "{{links.apiDefaultDatasetUrl}}/items"
      }
    }
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "fields": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "title": "url"
          },
          "title": {
            "type": "string",
            "title": "title"
          },
          "description": {
            "type": "string",
            "title": "description"
          },
          "markdown": {
            "type": "string",
            "title": "markdown"
          },
          "wordCount": {
            "type": "string",
            "title": "wordCount"
          }
        }
      },
      "views": {
        "overview": {
          "title": "Extracted Web Markdown Documents",
          "transformation": {
            "fields": [
              "url",
              "title",
              "description",
              "markdown",
              "wordCount"
            ]
          },
          "display": {
            "component": "table",
            "properties": {}
          }
        }
      }
    }
  }
}
